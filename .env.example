# Copy to .env (git-ignored) and adjust. Contains NO secrets.
# The engine reads plain environment variables; it does not auto-load .env,
# so export them yourself (e.g. `set -a; source .env; set +a`).

NIFTY_LOG_LEVEL=INFO
NIFTY_DATA_DIR=data

# Volume source: none | index_reported | index_futures | constituent_aggregate | etf_proxy
# Relative volume is only computed for traded-volume sources (see README).
NIFTY_VOLUME_SOURCE=none
NIFTY_RVOL_MODE=rolling            # rolling | time_of_day
NIFTY_RVOL_LOOKBACK=20

NIFTY_EMA_FAST=9
NIFTY_EMA_SLOW=21
NIFTY_SMA_PERIOD=20
NIFTY_CPR_MIN_SESSION_CANDLES=75

# --- UNVALIDATED placeholder thresholds (not research results) ---
NIFTY_REGIME_SLOPE_LOOKBACK=6
NIFTY_REGIME_TREND_SLOPE_MIN_PCT=0.02
NIFTY_REGIME_RANGE_SPREAD_MAX_PCT=0.05
NIFTY_REGIME_USE_CPR_FILTER=true
NIFTY_SM_MAX_BARS_TO_RETEST=6
NIFTY_SM_MAX_BARS_TO_CONFIRM=3
NIFTY_SM_ALERT_TTL_BARS=3
NIFTY_SM_EXPIRE_AT_SESSION_END=true   # also caps alert expiry at the 15:30 close
NIFTY_RULE_BREAKOUT_BUFFER_PCT=0.02
NIFTY_RULE_RETEST_TOLERANCE_PCT=0.03
NIFTY_RULE_INVALIDATION_BUFFER_PCT=0.05
# NIFTY_RULE_CONFIRMATION_MIN_RVOL=1.5   # optional; requires a traded-volume NIFTY_VOLUME_SOURCE (else config error)

# Future integrations (NOT used yet). Set these only in your shell or a secret
# manager, never in a committed file:
# FYERS_APP_ID=
# FYERS_SECRET_KEY=
# FYERS_ACCESS_TOKEN=
